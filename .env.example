# ==========================================
# UFGuessr Environment Variables Example
# ==========================================
# Copy this file to .env or .env.local and fill in your values.

# ------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase)
# ------------------------------------------
# Pooled database connection string for serverless API routes
DATABASE_URL=""

# Direct database connection string for Prisma migrations
DIRECT_URL=""

# ------------------------------------------
# 2. ADMIN AUTHENTICATION
# ------------------------------------------
# Administrator account credentials for access to /admin dashboard
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# ------------------------------------------
# 3. JWT SECURITY
# ------------------------------------------
# Secret key used to sign and verify HTTP-only admin JWT tokens
# Generate a strong random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=""

# ------------------------------------------
# 4. PRIVACY & IP HASHING SALT
# ------------------------------------------
# Secret salt used in SHA-256 IP anonymization hashing pipeline
# Generate a strong random string (e.g. `openssl rand -hex 32`)
PRIVACY_SALT=""

# ------------------------------------------
# 5. PUSH NOTIFICATIONS (Optional - ntfy.sh)
# ------------------------------------------
# ntfy.sh topic name for instant phone alerts on community location submissions
NTFY_TOPIC=""
NTFY_SERVER_URL="https://ntfy.sh"

# ------------------------------------------
# 6. APPLICATION URL
# ------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
